---
import datos from "../datos/inicio.json";
const wa = `https://wa.me/${datos.contacto.whatsapp}`;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
  <footer class="footer">
    <div class="container footer-grid">
      <a class="footer-logo" href={`${base}#inicio`} aria-label="Línea Blanca, volver arriba"><span class="logo-plate"><img src={`${base}brand/logo-linea-blanca.png`} alt="Línea Blanca" width="208" height="52" loading="lazy" /></span></a>
      <nav class="footer-links" aria-label="Pie"><a href={`${base}servicios/`}>Equipos</a><a href={`${base}contacto/`}>Contacto</a><a href={`${base}#preguntas`}>Preguntas</a></nav>
      <a class="footer-tel" href={wa} target="_blank" rel="noopener">+57 {datos.contacto.telefonoVisible}</a>
    </div>
    <div class="container footer-legal">
      <p>© {new Date().getFullYear()} Línea Blanca. Todos los derechos reservados.</p>
      <p>Las marcas se mencionan solo con fines informativos. Línea Blanca no es el servicio técnico oficial de ninguna marca.</p>
      {datos.creditos.length > 0 && <p>Fotografías: {datos.creditos.map((c) => c.texto).join(" · ")}</p>}
    </div>
  </footer>

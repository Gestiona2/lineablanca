---
import { sitio, servicios, marcas, ciudades, ruta, rutaCiudad, recurso, wa } from "../lib/sitio.js";
import inicio from "../datos/inicio.json";
const destacadas = inicio.marcasInicio.map((s) => marcas.find((m) => m.slug === s)).filter(Boolean).slice(0, 8);
---
<footer class="footer">
  <div class="container footer-top">
    <div class="footer-marca">
      <a class="footer-logo" href={ruta("")} aria-label="Línea Blanca, inicio"><span class="logo-plate"><img src={recurso("brand/logo-linea-blanca.png")} alt="Línea Blanca" width="208" height="52" loading="lazy" /></span></a>
      <p>{sitio.pie.descripcion}</p>
      <a class="footer-tel" href={wa()} target="_blank" rel="noopener">+57 {sitio.telefono}</a>
      <ul class="footer-horario">{sitio.horarioLineas.map((l) => <li>{l}</li>)}</ul>
    </div>
    <nav class="footer-col" aria-label="Servicios">
      <h2>Servicios</h2>
      <ul>
        {servicios.map((s) => <li><a href={ruta(`${s.slug}/`)}>{s.nombre}</a></li>)}
      </ul>
    </nav>
    <nav class="footer-col" aria-label="Marcas">
      <h2>Marcas</h2>
      <ul>
        {destacadas.map((m) => <li><a href={ruta(`marcas/${m.slug}/`)}>{m.nombre}</a></li>)}
        <li><a href={ruta("marcas/")}>Ver todas las marcas</a></li>
      </ul>
    </nav>
    <nav class="footer-col" aria-label="Dónde atendemos">
      <h2>Dónde atendemos</h2>
      <ul>
        {ciudades.map((c) => <li><a href={rutaCiudad(c)}>{c.nombre}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container footer-legal">
    <p class="footer-aviso">{sitio.pie.aviso}</p>
    <div class="footer-fila">
      <p>© {new Date().getFullYear()} Línea Blanca. {sitio.pie.derechos}</p>
      <ul class="footer-legales">
        <li><a href={ruta("nosotros/")}>Nosotros</a></li>
        <li><a href={ruta("contacto/")}>Contacto</a></li>
        {sitio.legales.map((l) => <li><a href={ruta(l.href)}>{l.texto}</a></li>)}
      </ul>
    </div>
    <p class="footer-creditos">Fotografías: Brian Zajac y Lisa Anna en Unsplash.</p>
  </div>
</footer>

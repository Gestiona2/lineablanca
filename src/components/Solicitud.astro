---
import datos from "../datos/inicio.json";
const equipos = datos.servicios.grupos.flatMap((g) => g.items);
---
  <section class="solicitud" id="solicitud">
    <div class="container solicitud-grid">
      <div class="solicitud-copy">
        <h2>{datos.solicitud.titulo}</h2>
        <p>{datos.solicitud.texto}</p>
        <a class="solicitud-tel" href={`tel:+${datos.contacto.whatsapp}`}>+57 {datos.contacto.telefonoVisible}</a>
        <ul class="horario">
          {datos.contacto.horarioLineas.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <form class="form" id="solicitudServicio">
        <label for="ciudad">{datos.solicitud.ciudadLabel}</label>
        <select id="ciudad" name="ciudad" required>
          <option value="" disabled selected>{datos.solicitud.ciudadPlaceholder}</option>
          {datos.solicitud.ciudades.map((c) => <option value={c}>{c}</option>)}
        </select>
        <label for="servicio">{datos.solicitud.servicioLabel}</label>
        <select id="servicio" name="servicio" required>
          <option value="" disabled selected>{datos.solicitud.servicioPlaceholder}</option>
          {equipos.map((e) => <option value={e.nombre}>{e.nombre}</option>)}
        </select>
        <label for="problema">{datos.solicitud.problemaLabel}</label>
        <textarea id="problema" name="problema" rows="3" placeholder={datos.solicitud.problemaPlaceholder}></textarea>
        <button class="btn btn-primary btn-lg" type="submit">{datos.solicitud.boton}<span class="btn-arrow" aria-hidden="true">→</span></button>
        <p class="form-note">{datos.solicitud.aviso}</p>
      </form>
    </div>
  </section>

---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { sitio, ruta, recurso, wa, categorias } from "../lib/sitio.js";
const { titulo, descripcion = sitio.descripcion, activa = "", jsonld = null } = Astro.props;
const demo = String(Astro.site ?? "").includes("demos.");
const canonica = new URL(Astro.url.pathname, Astro.site ?? sitio.dominio).href;
const claveTema = sitio.claveTema;
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={descripcion} />
    <meta name="robots" content={demo ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonica} />
    <title>{titulo}</title>
    <link rel="icon" href={recurso("brand/logo-linea-blanca.png")} />
    <style is:inline set:html={`@font-face{font-family:"Manrope";font-style:normal;font-weight:200 800;font-display:swap;src:local("Manrope"),url(${recurso("fonts/manrope-variable.woff2")}) format("woff2")}`}></style>
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonica} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>}
    <script is:inline define:vars={{ claveTema }}>
      // Claro por defecto. Solo se pasa a oscuro si la persona lo eligió con el botón.
      try { if (localStorage.getItem(claveTema) === "oscuro") document.documentElement.dataset.theme = "dark"; } catch (e) {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href={ruta("")} class="nav-logo" aria-label="Línea Blanca, inicio">
          <span class="logo-plate"><img src={recurso("brand/logo-linea-blanca.png")} alt="Línea Blanca — Servicio técnico de electrodomésticos" width="208" height="52" /></span>
        </a>
        <nav class="nav-links" id="navLinks" aria-label="Navegación principal">
          {sitio.menu.map((m) => m.id === "servicios" ? (
            <div class="nav-item">
              <a href={ruta(m.href)} class="nav-con-menu" aria-current={activa === m.id ? "page" : undefined} aria-haspopup="true">{m.texto}<Icon nombre="chevron-down" tamano={16} /></a>
              <div class="mega" role="group" aria-label="Servicios">
                <div class="mega-lateral">
                  <p class="mega-t">¿Qué se te dañó?</p>
                  <p class="mega-p">Elige tu equipo y mira qué arreglamos en tu casa.</p>
                  <a class="btn btn-wa" href={wa("Hola, quiero agendar un servicio técnico.")} target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={20} />Escribir por WhatsApp</a>
                  <a class="mega-todos" href={ruta("servicios/")}>Ver todos los servicios<Icon nombre="arrow-right" tamano={18} /></a>
                </div>
                <div class="mega-principal">
                  <div class="mega-tabs" role="tablist" aria-label="Categorías">
                    {categorias.map((c, i) => <button type="button" role="tab" class="mega-tab" data-cat={c.id} aria-selected={i === 0 ? "true" : "false"}>{c.titulo}</button>)}
                  </div>
                  {categorias.map((c) => (
                    <ul class="mega-lista" role="tabpanel" data-cat={c.id}>
                      {c.items.map((it) => <li><a href={ruta(`${it.slug}/`)}><strong>{it.nombre}</strong><span>{it.subtitulo}</span></a></li>)}
                    </ul>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={ruta(m.href)} aria-current={activa === m.id ? "page" : undefined}>{m.texto}</a>
          ))}
          <div class="nav-movil-acciones">
            <a class="btn btn-wa" href={wa("Hola, quiero agendar un servicio técnico.")} target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={20} />WhatsApp</a>
            <a class="btn btn-ghost" href={`tel:+${sitio.whatsapp}`}><Icon nombre="phone" tamano={20} />Llamar {sitio.telefono}</a>
          </div>
        </nav>
        <div class="nav-contacto">
          <a class="nav-tel" href={`tel:+${sitio.whatsapp}`} aria-label={`Llamar al ${sitio.telefono}`}><Icon nombre="phone" tamano={18} /><span>{sitio.telefono}</span></a>
          <a class="btn btn-wa nav-wa" href={wa("Hola, quiero agendar un servicio técnico.")} target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={18} />WhatsApp</a>
        </div>
        <div class="nav-tools">
          <button id="botonTema" class="icon-btn" type="button" aria-pressed="false" aria-label="Activar tema oscuro" title="Tema oscuro">
            <svg class="i-luna" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sol" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button id="botonMenu" class="icon-btn menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <a href={ruta("contacto/#agendar")} class="floating-contact" aria-label="Agendar un servicio">
      <Icon nombre="calendar-check" tamano={20} /><span>Agendar</span>
    </a>
    <div class="barra-movil" role="group" aria-label="Contacto rápido">
      <a class="btn btn-ghost" href={`tel:+${sitio.whatsapp}`}><Icon nombre="phone" tamano={20} />Llamar</a>
      <a class="btn btn-wa" href={wa("Hola, quiero agendar un servicio técnico.")} target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={20} />WhatsApp</a>
    </div>
    <script is:inline define:vars={{ claveTema }}>
      const raiz = document.documentElement;
      const botonTema = document.querySelector("#botonTema");
      const pintarTema = () => {
        const oscuro = raiz.dataset.theme === "dark";
        botonTema?.setAttribute("aria-pressed", String(oscuro));
        botonTema?.setAttribute("aria-label", oscuro ? "Volver al tema claro" : "Activar tema oscuro");
        botonTema?.setAttribute("title", oscuro ? "Tema claro" : "Tema oscuro");
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", oscuro ? "#08121f" : "#ffffff");
      };
      pintarTema();
      botonTema?.addEventListener("click", () => {
        const oscuro = raiz.dataset.theme !== "dark";
        raiz.dataset.theme = oscuro ? "dark" : "light";
        try { localStorage.setItem(claveTema, oscuro ? "oscuro" : "claro"); } catch (e) {}
        pintarTema();
      });
      const boton = document.querySelector("#botonMenu");
      const menu = document.querySelector("#navLinks");
      const cerrar = () => {
        menu?.classList.remove("abierto");
        boton?.setAttribute("aria-expanded", "false");
        boton?.setAttribute("aria-label", "Abrir menú");
      };
      boton?.addEventListener("click", () => {
        const abierto = menu.classList.toggle("abierto");
        boton.setAttribute("aria-expanded", String(abierto));
        boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
      });
      menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrar));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrar(); });
      // Menú de servicios: pestañas por categoría
      const megaTabs = [...document.querySelectorAll(".mega-tab")];
      const megaListas = [...document.querySelectorAll(".mega-lista")];
      const verCat = (id) => { megaTabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.cat === id))); megaListas.forEach((l) => { l.hidden = l.dataset.cat !== id; }); };
      megaTabs.forEach((t) => { ["mouseenter", "focus", "click"].forEach((ev) => t.addEventListener(ev, () => verCat(t.dataset.cat))); });
      if (megaTabs[0]) verCat(megaTabs[0].dataset.cat);
      const nav = document.querySelector("#nav");
      const marcarScroll = () => nav?.classList.toggle("con-scroll", window.scrollY > 8);
      marcarScroll();
      window.addEventListener("scroll", marcarScroll, { passive: true });

      // Aparición suave al desplazarse. Sin script o con "reducir movimiento", todo se ve desde el principio.
      const quiereMovimiento = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (quiereMovimiento && "IntersectionObserver" in window) {
        const objetivos = document.querySelectorAll(".section-head, .pasos > li, .compromisos-lista > li, .testimonios-lista > li, .pagos-lista > li, .logos-marcas a, .garantia-grid > *, .faq-lista details, .indice-grupo, .marcas-indice > li, .equipo-card, .incluye > li, .cifras > li");
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
        objetivos.forEach((el, i) => {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight) return; // lo que ya se ve no se anima
          el.classList.add("rv"); el.style.setProperty("--rv-d", `${(i % 4) * 60}ms`); io.observe(el);
        });
      }
    </script>
  </body>
</html>

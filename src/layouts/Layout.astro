---
import "../styles/global.css";
import sitio from "../datos/sitio.json";
import inicio from "../datos/inicio.json";
const { titulo, descripcion = sitio.descripcion } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const wa = `https://wa.me/${inicio.contacto.whatsapp}`;
const claveTema = sitio.claveTema;
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link rel="icon" href={`${base}brand/logo-linea-blanca.png`} />
    <style is:inline set:html={`@font-face{font-family:"Manrope";font-style:normal;font-weight:200 800;font-display:swap;src:local("Manrope"),url(${base}fonts/manrope-variable.woff2) format("woff2")}`}></style>
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <script is:inline define:vars={{ claveTema }}>
      // Claro por defecto. Solo se pasa a oscuro si la persona lo eligió con el botón.
      try { if (localStorage.getItem(claveTema) === "oscuro") document.documentElement.dataset.theme = "dark"; } catch (e) {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href={base} class="nav-logo" aria-label="Línea Blanca, inicio">
          <span class="logo-plate"><img src={`${base}brand/logo-linea-blanca.png`} alt="Línea Blanca — Servicio técnico de electrodomésticos" width="208" height="52" /></span>
        </a>
        <nav class="nav-links" id="navLinks" aria-label="Navegación principal">
          <a href={`${base}servicios/`}>Equipos</a>
          <a href={`${base}#proceso`}>Cómo trabajamos</a>
          <a href={`${base}#cobertura`}>Cobertura</a>
          <a href={`${base}#preguntas`}>Preguntas</a>
          <a href={`${base}contacto/`}>Contacto</a>
          <a href={`${base}#solicitud`} class="btn btn-primary nav-cta">Solicitar servicio</a>
        </nav>
        <div class="nav-tools">
          <button id="botonTema" class="icon-btn" type="button" aria-pressed="false" aria-label="Activar tema oscuro" title="Tema oscuro">
            <svg class="i-luna" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sol" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button id="botonMenu" class="icon-btn menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <a href={wa} class="floating-contact" target="_blank" rel="noopener" aria-label="Escribir a Línea Blanca por WhatsApp">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3.5 20.4l1.5-4.3A8.5 8.5 0 1 1 20.5 11.6z"/></svg>
      <span>WhatsApp</span>
    </a>
    <script is:inline define:vars={{ claveTema, numero: inicio.contacto.whatsapp }}>
      const raiz = document.documentElement;
      const botonTema = document.querySelector("#botonTema");
      const pintarTema = () => {
        const oscuro = raiz.dataset.theme === "dark";
        botonTema?.setAttribute("aria-pressed", String(oscuro));
        botonTema?.setAttribute("aria-label", oscuro ? "Volver al tema claro" : "Activar tema oscuro");
        botonTema?.setAttribute("title", oscuro ? "Tema claro" : "Tema oscuro");
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", oscuro ? "#08121f" : "#ffffff");
      };
      pintarTema();
      botonTema?.addEventListener("click", () => {
        const oscuro = raiz.dataset.theme !== "dark";
        raiz.dataset.theme = oscuro ? "dark" : "light";
        try { localStorage.setItem(claveTema, oscuro ? "oscuro" : "claro"); } catch (e) {}
        pintarTema();
      });

      const boton = document.querySelector("#botonMenu");
      const menu = document.querySelector("#navLinks");
      const cerrar = () => {
        menu?.classList.remove("abierto");
        boton?.setAttribute("aria-expanded", "false");
        boton?.setAttribute("aria-label", "Abrir menú");
      };
      boton?.addEventListener("click", () => {
        const abierto = menu.classList.toggle("abierto");
        boton.setAttribute("aria-expanded", String(abierto));
        boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
      });
      menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrar));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrar(); });

      const nav = document.querySelector("#nav");
      const marcarScroll = () => nav?.classList.toggle("con-scroll", window.scrollY > 8);
      marcarScroll();
      window.addEventListener("scroll", marcarScroll, { passive: true });

      // Selector de equipos
      const lista = document.querySelector("[data-equipos]");
      if (lista) {
        const pestanas = [...lista.querySelectorAll('[role="tab"]')];
        const paneles = [...document.querySelectorAll("[data-panel]")];
        const activar = (id, enfocar, fijar = true) => {
          pestanas.forEach((p) => {
            const on = p.dataset.id === id;
            p.setAttribute("aria-selected", String(on));
            p.tabIndex = on ? 0 : -1;
            if (on && enfocar) p.focus();
          });
          paneles.forEach((p) => { p.hidden = p.dataset.panel !== id; });
          if (!fijar) return;
          const selector = document.querySelector("#servicio");
          const nombre = pestanas.find((p) => p.dataset.id === id)?.dataset.nombre;
          if (selector && nombre) selector.value = nombre;
        };
        pestanas.forEach((p, i) => {
          p.addEventListener("click", () => activar(p.dataset.id, false));
          p.addEventListener("keydown", (e) => {
            const salto = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
            if (salto) {
              e.preventDefault();
              const sig = pestanas[(i + salto + pestanas.length) % pestanas.length];
              activar(sig.dataset.id, true);
            }
          });
        });
        document.querySelectorAll("[data-pedir]").forEach((a) => a.addEventListener("click", () => {
          const id = a.closest("[data-panel]")?.dataset.panel;
          const nombre = pestanas.find((p) => p.dataset.id === id)?.dataset.nombre;
          const selector = document.querySelector("#servicio");
          if (selector && nombre) selector.value = nombre;
        }));
        activar(pestanas[0].dataset.id, false, false);
      }

      // Formulario: abre WhatsApp con el mensaje escrito; no envía nada por sí solo.
      const solicitud = document.querySelector("#solicitudServicio");
      solicitud?.addEventListener("submit", (evento) => {
        evento.preventDefault();
        const datos = new FormData(solicitud);
        const problema = String(datos.get("problema") || "").trim();
        const mensaje = [
          "Hola, quiero solicitar atención para un electrodoméstico.",
          `Ciudad o municipio: ${datos.get("ciudad")}`,
          `Equipo: ${datos.get("servicio")}`,
          problema ? `Falla: ${problema}` : "",
        ].filter(Boolean).join("\n");
        window.open(`https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`, "_blank", "noopener,noreferrer");
      });
    </script>
  </body>
</html>

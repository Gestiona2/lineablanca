---
import Layout from "../layouts/Layout.astro";
import Solicitud from "../components/Solicitud.astro";
import Pie from "../components/Pie.astro";
import datos from "../datos/inicio.json";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const ind = datos.servicios.indice;
---
<Layout titulo="Equipos que atendemos | Línea Blanca" descripcion={ind.texto}>
  <section class="pagina-hero">
    <div class="container">
      <h1>{ind.titulo}</h1>
      <p class="lead">{ind.texto}</p>
    </div>
  </section>
  <section class="indice">
    <div class="container">
      {datos.servicios.grupos.map((g) => (
        <div class="indice-grupo">
          <h2>{g.nombre}</h2>
          <ul>
            {g.items.map((it) => (
              <li><a href={`${base}${it.slug}/`}><span class="indice-nombre">{it.nombre}</span><span class="indice-resumen">{it.resumen}</span><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <Solicitud />
  <Pie />
</Layout>

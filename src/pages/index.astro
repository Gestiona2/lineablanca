---
import Layout from "../layouts/Layout.astro";
import Solicitud from "../components/Solicitud.astro";
import Pie from "../components/Pie.astro";
import datos from "../datos/inicio.json";
const wa = `https://wa.me/${datos.contacto.whatsapp}`;
const mensajeInicial = encodeURIComponent("Hola, quiero solicitar un servicio técnico.");
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const equipos = datos.servicios.grupos.flatMap((g) => g.items);
---

<Layout titulo={datos.meta.titulo} descripcion={datos.meta.descripcion}>
  <section class="hero" id="inicio">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{datos.portada.titulo}</h1>
        <p class="lead">{datos.portada.texto}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={`${wa}?text=${mensajeInicial}`} target="_blank" rel="noopener">{datos.portada.cta}<span class="btn-arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost btn-lg" href={`${base}#servicios`}>{datos.portada.ctaSecundario}</a>
        </div>
      </div>
      <figure class="hero-media">
        <img src={`${base}${datos.portada.imagen}`} alt={datos.portada.imagenAlt} width="1200" height="1400" fetchpriority="high" />
        <figcaption class="hero-placa">
          <strong>{datos.portada.placaTitulo}</strong>
          <span>{datos.portada.placaTexto}</span>
        </figcaption>
      </figure>
    </div>
    <div class="container hero-ciudades">
      <p>{datos.portada.ciudadesEtiqueta}</p>
      <ul>{datos.cobertura.ciudades.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section servicios" id="servicios">
    <div class="container">
      <div class="section-head">
        <h2>{datos.servicios.titulo}</h2>
        <p>{datos.servicios.texto}</p>
      </div>
      <div class="equipos">
        <div class="equipos-lista" role="tablist" aria-orientation="vertical" aria-label="Electrodomésticos" data-equipos>
          {datos.servicios.grupos.map((grupo) => (
            <div class="equipos-grupo" role="presentation">
              <p class="equipos-grupo-nombre" role="presentation">{grupo.nombre}</p>
              {grupo.items.map((item, i) => (
                <button class="equipo-tab" type="button" role="tab" id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={grupo === datos.servicios.grupos[0] && i === 0 ? "true" : "false"} data-id={item.id} data-nombre={item.nombre}>
                  <span>{item.nombre}</span>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              ))}
            </div>
          ))}
        </div>
        <div class="equipos-detalle">
          {equipos.map((item) => (
            <article class="equipo-panel" role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} data-panel={item.id} hidden={item.id !== equipos[0].id ? true : undefined}>
              <h3>{item.nombre}</h3>
              <p class="equipo-resumen">{item.resumen}</p>
              <h4>{datos.servicios.etiquetaFallas}</h4>
              <ul class="fallas">
                {item.fallas.map((falla) => <li>{falla}</li>)}
              </ul>
              <div class="equipo-acciones">
                <a class="btn btn-primary" href={`${base}#solicitud`} data-pedir>{datos.servicios.cta}<span class="btn-arrow" aria-hidden="true">→</span></a>
                <a class="btn btn-ghost" href={`${base}${item.slug}/`}>{datos.servicios.verPagina}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section compromisos" id="compromisos">
    <div class="container compromisos-grid">
      <div class="compromisos-intro">
        <h2>{datos.compromisos.titulo}</h2>
        <p>{datos.compromisos.texto}</p>
        <img class="compromisos-foto" src={`${base}${datos.compromisos.imagen}`} alt={datos.compromisos.imagenAlt} width="1000" height="667" loading="lazy" />
      </div>
      <ul class="compromisos-lista">
        {datos.compromisos.items.map((c) => <li><h3>{c.titulo}</h3><p>{c.texto}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section proceso" id="proceso">
    <div class="container">
      <div class="section-head">
        <h2>{datos.proceso.titulo}</h2>
      </div>
      <ol class="pasos">
        {datos.proceso.pasos.map((paso) => <li><h3>{paso.titulo}</h3><p>{paso.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section marcas" id="marcas">
    <div class="container marcas-grid">
      <div>
        <h2>{datos.marcas.titulo}</h2>
        <p>{datos.marcas.texto}</p>
      </div>
      <ul class="marcas-lista">
        {datos.marcas.items.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section cobertura" id="cobertura">
    <div class="container">
      <div class="section-head">
        <h2>{datos.cobertura.titulo}</h2>
        <p>{datos.cobertura.texto}</p>
      </div>
      <div class="cobertura-grid">
        <div class="cobertura-bloque cobertura-ciudades">
          <h3>{datos.cobertura.ciudadesTitulo}</h3>
          <ul>{datos.cobertura.ciudades.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div class="cobertura-bloque">
          <h3>{datos.cobertura.municipiosTitulo}</h3>
          <ul class="chips">{datos.cobertura.municipios.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div class="cobertura-bloque">
          <h3>{datos.cobertura.barriosTitulo}</h3>
          <ul class="chips">{datos.cobertura.barrios.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq" id="preguntas">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2>{datos.faq.titulo}</h2>
        <a class="btn btn-ghost" href={`${wa}?text=${mensajeInicial}`} target="_blank" rel="noopener">Preguntar por WhatsApp<span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="faq-lista">
        {datos.faq.items.map((item) => (
          <details>
            <summary>{item.pregunta}<span class="mas" aria-hidden="true"></span></summary>
            <p>{item.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Solicitud />

  <Pie />
</Layout>

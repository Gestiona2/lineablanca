---
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
const wa = `https://wa.me/${datos.contacto.whatsapp}`;
const listaServicios = datos.servicios.grupos.flatMap((grupo) => grupo.items);
---

<Layout titulo={datos.meta.titulo} descripcion={datos.meta.descripcion} activa="inicio">
  <section class="hero" id="inicio">
    <div class="hero-image" role="img" aria-label={datos.portada.imagenAlt}></div>
    <div class="hero-wash"></div>
    <div class="container hero-content">
      <p class="hero-kicker"><span></span>{datos.portada.etiqueta}</p>
      <h1>{datos.portada.titulo}</h1>
      <p class="hero-copy">{datos.portada.texto}</p>
      <div class="hero-actions">
        <a class="button button-blue" href={`${import.meta.env.BASE_URL}#solicitud`}>{datos.portada.cta}<span aria-hidden="true">↗</span></a>
        <a class="button button-quiet" href={`${import.meta.env.BASE_URL}#servicios`}>{datos.portada.ctaSecundario}<span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-note"><span class="note-mark">LB</span><span>Atención para electrodomésticos<br />de tu hogar</span></div>
    </div>
    <div class="hero-caption">LÍNEA BLANCA <span>·</span> SERVICIO TÉCNICO</div>
  </section>

  <section class="intro-band">
    <div class="container intro-inner"><p>Un buen diagnóstico.<br /><strong>Una casa que vuelve a funcionar.</strong></p><a href={wa} target="_blank" rel="noopener">Hablar con un asesor <span>↗</span></a></div>
  </section>

  <section class="services section-pad" id="servicios">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">LO QUE REPARAMOS</p><h2>{datos.servicios.titulo}</h2></div><p>{datos.servicios.texto}</p></div>
      <div class="service-groups">
        {datos.servicios.grupos.map((grupo) => <div class="service-group"><h3>{grupo.nombre}</h3><div class="service-grid">{grupo.items.map((servicio) => <a class="service-item" href={`${import.meta.env.BASE_URL}#solicitud`}><div><h4>{servicio.nombre}</h4><p>{servicio.detalle}</p></div><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div></div>)}
      </div>
    </div>
  </section>

  <section class="care-section section-pad" id="atencion">
    <div class="container care-layout"><div><p class="eyebrow">MÁS QUE UNA REPARACIÓN</p><h2>{datos.atencion.titulo}</h2><p class="care-intro">{datos.atencion.texto}</p></div><div class="care-points">{datos.atencion.puntos.map((punto) => <article><h3>{punto.titulo}</h3><p>{punto.texto}</p></article>)}</div></div>
  </section>

  <section class="brands-section section-pad" id="marcas">
    <div class="container brands-layout"><div><p class="eyebrow">EQUIPOS Y FABRICANTES</p><h2>{datos.marcas.titulo}</h2><p>{datos.marcas.texto}</p></div><ul class="brand-list">{datos.marcas.items.map((marca) => <li>{marca}</li>)}</ul></div>
  </section>

  <section class="process-section section-pad" id="proceso">
    <div class="container process-layout">
      <div class="process-lead"><p class="eyebrow">SIN COMPLICACIONES</p><h2>{datos.proceso.titulo}</h2><p>El primer paso es contarnos qué está pasando. Te ayudamos a coordinar la atención.</p><a class="text-link" href={wa} target="_blank" rel="noopener">Iniciar por WhatsApp <span>↗</span></a></div>
      <div class="process-list">{datos.proceso.pasos.map((paso, index) => <article class="process-step"><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{paso.titulo}</h3><p>{paso.texto}</p></div></article>)}</div>
    </div>
  </section>

  <section class="coverage section-pad" id="cobertura">
    <div class="container coverage-layout"><div><p class="eyebrow">COBERTURA</p><h2>{datos.cobertura.titulo}</h2></div><div><p>{datos.cobertura.texto}</p><ul class="city-list">{datos.cobertura.ciudades.map((ciudad) => <li>{ciudad}</li>)}</ul><h3 class="nearby-title">{datos.cobertura.municipiosTitulo}</h3><p class="nearby-list">{datos.cobertura.municipios.join(" · ")}</p><h3 class="nearby-title">{datos.cobertura.barriosTitulo}</h3><p class="nearby-list">{datos.cobertura.barrios.join(" · ")}</p></div></div>
  </section>

  <section class="faq-section section-pad" id="preguntas"><div class="container faq-layout"><div><p class="eyebrow">ANTES DE ESCRIBIRNOS</p><h2>Resolvemos tus dudas.</h2><a class="text-link" href={wa} target="_blank" rel="noopener">Preguntar por WhatsApp <span>↗</span></a></div><div class="faq-list">{datos.faq.map((item) => <details><summary>{item.pregunta}<span aria-hidden="true">+</span></summary><p>{item.respuesta}</p></details>)}</div></div></section>

  <section class="contact-section" id="contacto"><div class="container contact-inner"><div><p class="eyebrow">LÍNEA BLANCA · SERVICIO TÉCNICO</p><h2>{datos.contacto.titulo}</h2><p>{datos.contacto.texto}</p></div><a class="button button-white" href={`${wa}?text=${encodeURIComponent("Hola, quiero solicitar un servicio técnico.")}`} target="_blank" rel="noopener">Escribir al {datos.contacto.telefonoVisible}<span aria-hidden="true">↗</span></a></div></section>

  <section class="request-section section-pad" id="solicitud">
    <div class="container request-layout"><div class="request-copy"><p class="eyebrow">SOLICITUD DIRECTA</p><h2>{datos.solicitud.titulo}</h2><p>{datos.solicitud.texto}</p><a class="text-link" href={`tel:+${datos.contacto.whatsapp}`}>Llamar al +57 {datos.contacto.telefonoVisible} <span>↗</span></a></div><form class="request-form" id="solicitudServicio"><label for="ciudad">{datos.solicitud.ciudadLabel}</label><select id="ciudad" name="ciudad" required><option value="" disabled selected>{datos.solicitud.ciudadPlaceholder}</option>{datos.solicitud.ciudades.map((ciudad) => <option value={ciudad}>{ciudad}</option>)}</select><label for="servicio">{datos.solicitud.servicioLabel}</label><select id="servicio" name="servicio" required><option value="" disabled selected>{datos.solicitud.servicioPlaceholder}</option>{listaServicios.map((servicio) => <option value={servicio.nombre}>{servicio.nombre}</option>)}</select><label for="problema">{datos.solicitud.problemaLabel}</label><textarea id="problema" name="problema" rows="3" placeholder={datos.solicitud.problemaPlaceholder}></textarea><button class="button button-blue" type="submit">{datos.solicitud.boton}<span aria-hidden="true">↗</span></button><p class="form-note">{datos.solicitud.aviso}</p></form></div>
  </section>

  <footer class="site-footer"><div class="container footer-top"><a class="footer-logo" href={`${import.meta.env.BASE_URL}#inicio`}><img src={`${import.meta.env.BASE_URL}brand/logo-linea-blanca.png`} alt="Línea Blanca — Servicio técnico de electrodomésticos" /></a><p>Servicio técnico y mantenimiento<br />de electrodomésticos.<br /><span>{datos.contacto.horario}</span></p><a class="footer-phone" href={wa} target="_blank" rel="noopener">+57 {datos.contacto.telefonoVisible} <span>↗</span></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Línea Blanca. Todos los derechos reservados.</span><span>Las marcas se mencionan solo con fines informativos. No somos el servicio oficial de ninguna marca.</span></div></footer>
</Layout>

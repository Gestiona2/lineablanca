---
import Layout from "../layouts/Layout.astro";
import Pie from "../components/Pie.astro";
import { ruta, wa, sitio } from "../lib/sitio.js";
import d from "../datos/404.json";
---
<Layout titulo={d.meta.titulo} descripcion={d.meta.descripcion}>
  <section class="pagina-hero pagina-404">
    <div class="container">
      <p class="codigo-404">{d.codigo}</p>
      <h1>{d.titulo}</h1>
      <p class="lead">{d.texto}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={ruta("")}>{d.inicio}<span class="btn-arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost btn-lg" href={ruta("servicios/")}>{d.servicios}</a>
        <a class="btn btn-ghost btn-lg" href={wa(sitio.mensajes.general)} target="_blank" rel="noopener">{d.whats}</a>
      </div>
    </div>
  </section>
  <Pie />
</Layout>

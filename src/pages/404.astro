---
import Layout from "../layouts/Layout.astro";
import Pie from "../components/Pie.astro";
import datos from "../datos/inicio.json";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const e = datos.pagina404;
---
<Layout titulo="Página no encontrada | Línea Blanca" descripcion={e.texto}>
  <section class="pagina-hero pagina-404">
    <div class="container">
      <h1>{e.titulo}</h1>
      <p class="lead">{e.texto}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={base}>{e.cta}<span class="btn-arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost btn-lg" href={`${base}servicios/`}>Ver los equipos</a>
      </div>
    </div>
  </section>
  <Pie />
</Layout>

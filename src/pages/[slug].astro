---
import Layout from "../layouts/Layout.astro";
import Formulario from "../components/Formulario.astro";
import Icon from "../components/Icon.astro";
import Pie from "../components/Pie.astro";
import { sitio, legalesData, servicios, ruta, recurso, wa, reemplazar, marcaPorNombre, ciudadesDeServicio, rutaCiudad } from "../lib/sitio.js";
import d from "../datos/servicios-pagina.json";

export function getStaticPaths() {
  return [
    ...servicios.map((s) => ({ params: { slug: s.slug }, props: { tipo: "servicio", item: s } })),
    ...legalesData.paginas.map((l) => ({ params: { slug: l.slug }, props: { tipo: "legal", item: l } })),
  ];
}
const { tipo, item } = Astro.props;
const esServicio = tipo === "servicio";
const dd = d.detalle;
const ciudades = esServicio ? ciudadesDeServicio(item.slug) : [];
const relacionados = esServicio ? [...servicios.filter((s) => s.categoria === item.categoria && s.slug !== item.slug), ...servicios.filter((s) => s.categoria !== item.categoria && s.slug !== item.slug)] : [];
const origen = Astro.site ?? sitio.dominio;
const jsonld = esServicio ? [
  { "@context": "https://schema.org", "@type": "Service", name: item.titulo, description: item.resumen, provider: { "@type": "HomeAndConstructionBusiness", name: sitio.nombre, telephone: `+${sitio.whatsapp}` }, areaServed: ciudades.map((c) => c.nombre) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: item.faq.map((f) => ({ "@type": "Question", name: f.pregunta, acceptedAnswer: { "@type": "Answer", text: f.respuesta } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(ruta(""), origen).href },
    { "@type": "ListItem", position: 2, name: "Servicios", item: new URL(ruta("servicios/"), origen).href },
    { "@type": "ListItem", position: 3, name: item.nombre, item: new URL(ruta(`${item.slug}/`), origen).href }] },
] : null;
const titulo = esServicio ? item.meta.titulo : `${item.titulo} | Línea Blanca`;
const descripcion = esServicio ? item.meta.descripcion : item.descripcion;
---
{esServicio ? (
<Layout titulo={titulo} descripcion={descripcion} activa="servicios" jsonld={jsonld}>
  <section class="equipo-hero">
    <div class="container">
      <nav class="migas" aria-label="Ruta"><a href={ruta("")}>Inicio</a><span aria-hidden="true">/</span><a href={ruta("servicios/")}>Servicios</a><span aria-hidden="true">/</span><span>{item.nombre}</span></nav>
      <div class="equipo-hero-grid">
        <div>
          <span class="icono-burbuja icono-burbuja-lg"><Icon nombre={item.icono} tamano={34} /></span>
          <h1>{item.titulo}</h1>
          <p class="lead">{item.subtitulo}</p>
          <div class="hero-actions">
            <a class="btn btn-wa btn-lg" href={wa(`${sitio.mensajes.servicio} ${item.nombre.toLowerCase()}.`)} target="_blank" rel="noopener">{d.cierre.boton}<span class="btn-arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost btn-lg" href={ruta("servicios/")}>Ver todos los servicios</a>
          </div>
          <dl class="datos-rapidos">
            <div><dt>{dd.etiquetas.garantia}</dt><dd>{dd.valores.garantia}</dd></div>
            <div><dt>{dd.etiquetas.cobertura}</dt><dd>{ciudades.length === 10 ? dd.valores.cobertura : ciudades.map((c) => c.nombre).join(", ")}</dd></div>
          </dl>
        </div>
        <div class="equipo-card">
          {item.imagen && <img src={recurso(item.imagen)} alt={item.imagenAlt} width="1200" height="900" fetchpriority="high" />}
          <h2>{dd.fallas}</h2>
          <ul class="fallas fallas-una">{item.fallas.map((f) => <li>{f}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section intro-servicio">
    <div class="container intro-grid">
      <div class="intro-texto">{item.intro.map((p) => <p>{p}</p>)}</div>
      <div>
        <h2>{dd.incluye}</h2>
        <ul class="incluye">{item.incluye.map((x) => <li><h3>{x.titulo}</h3><p>{x.texto}</p></li>)}</ul>
      </div>
    </div>
  </section>

  {item.variantes.length > 0 && (
    <section class="section variantes">
      <div class="container">
        <h2>{dd.variantes}</h2>
        <ul class="chips chips-lg">{item.variantes.map((v) => <li>{v}</li>)}</ul>
      </div>
    </section>
  )}

  {item.marcas.length > 0 && (
    <section class="section marcas-equipo">
      <div class="container marcas-grid">
        <div>
          <h2>{dd.marcas}</h2>
          <p>Los nombres se usan solo para identificar los equipos; Línea Blanca no es el servicio técnico oficial de ninguna marca.</p>
        </div>
        <ul class="marcas-lista">
          {item.marcas.map((m) => {
            const marca = marcaPorNombre(m);
            return marca ? <li><a href={ruta(`marcas/${marca.slug}/`)}>{m}</a></li> : <li>{m}</li>;
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="section donde-servicio">
    <div class="container">
      <div class="section-head"><h2>{dd.donde}</h2></div>
      <ul class="chips chips-lg">{ciudades.map((c) => <li><a href={rutaCiudad(c)}>{c.nombre}</a></li>)}</ul>
    </div>
  </section>

  <section class="section faq">
    <div class="container faq-grid">
      <div class="faq-intro"><h2>{dd.faq}</h2></div>
      <div class="faq-lista">
        {item.faq.map((f) => (<details><summary>{f.pregunta}<span class="mas" aria-hidden="true"></span></summary><p>{f.respuesta}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section otros">
    <div class="container">
      <div class="section-head"><h2>{dd.relacionados}</h2></div>
      <ul class="otros-lista">
        {relacionados.map((o) => <li><a href={ruta(`${o.slug}/`)}>{o.nombre}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>)}
      </ul>
    </div>
  </section>

  <Formulario servicioPre={item.nombre} titulo={dd.agendarTitulo} texto={dd.agendarTexto} />
  <Pie />
</Layout>
) : (
<Layout titulo={titulo} descripcion={descripcion}>
  <section class="pagina-hero">
    <div class="container">
      <nav class="migas" aria-label="Ruta"><a href={ruta("")}>Inicio</a><span aria-hidden="true">/</span><span>{legalesData.encabezado}</span></nav>
      <h1>{item.titulo}</h1>
      <p class="lead">{item.descripcion}</p>
      <p class="legal-fecha">{legalesData.actualizado}: {item.actualizado}</p>
    </div>
  </section>
  <section class="legal">
    <div class="container legal-grid">
      <nav class="legal-indice" aria-label={legalesData.indice}>
        <h2>{legalesData.indice}</h2>
        <ol>{item.bloques.map((b, i) => <li><a href={`#b${i + 1}`}>{b.titulo}</a></li>)}</ol>
      </nav>
      <article class="legal-texto">
        {item.bloques.map((b, i) => (<section id={`b${i + 1}`}><h2>{b.titulo}</h2>{b.parrafos.map((p) => <p>{p}</p>)}</section>))}
        <p class="legal-pie">{legalesData.pie} <a href={wa()} target="_blank" rel="noopener">WhatsApp +57 {sitio.telefono}</a>.</p>
      </article>
    </div>
  </section>
  <Pie />
</Layout>
)}

---
import Layout from "../layouts/Layout.astro";
import Solicitud from "../components/Solicitud.astro";
import Pie from "../components/Pie.astro";
import datos from "../datos/inicio.json";

export function getStaticPaths() {
  const equipos = datos.servicios.grupos.flatMap((g) => g.items);
  return equipos.map((item) => ({ params: { slug: item.slug }, props: { item, otros: equipos.filter((e) => e.id !== item.id) } }));
}
const { item, otros } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const wa = `https://wa.me/${datos.contacto.whatsapp}?text=${encodeURIComponent(`Hola, necesito servicio para: ${item.nombre}.`)}`;
const pag = datos.equipoPagina;
---
<Layout titulo={`${item.titulo} | Línea Blanca`} descripcion={`${item.resumen} Escríbenos por WhatsApp al +57 ${datos.contacto.telefonoVisible}.`}>
  <section class="equipo-hero">
    <div class="container equipo-hero-grid">
      <div>
        <h1>{item.titulo}</h1>
        <p class="lead">{item.resumen}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener">{pag.cta}<span class="btn-arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost btn-lg" href={`${base}servicios/`}>{pag.ctaSecundario}</a>
        </div>
      </div>
      <div class="equipo-card">
        {item.imagen && <img src={`${base}${item.imagen}`} alt={item.imagenAlt} width="1000" height="667" loading="eager" />}
        <h2>{datos.servicios.etiquetaFallas}</h2>
        <ul class="fallas fallas-una">
          {item.fallas.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {item.marcas.length > 0 && (
    <section class="section marcas-equipo">
      <div class="container marcas-grid">
        <div>
          <h2>{pag.etiquetaMarcas}</h2>
          <p>{pag.textoMarcas}</p>
        </div>
        <ul class="marcas-lista">{item.marcas.map((m) => <li>{m}</li>)}</ul>
      </div>
    </section>
  )}

  <section class="section otros">
    <div class="container">
      <div class="section-head"><h2>{pag.otrosTitulo}</h2></div>
      <ul class="otros-lista">
        {otros.map((o) => <li><a href={`${base}${o.slug}/`}>{o.nombre}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>)}
      </ul>
    </div>
  </section>

  <Solicitud />
  <Pie />
</Layout>

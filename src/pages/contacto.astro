---
import Layout from "../layouts/Layout.astro";
import Formulario from "../components/Formulario.astro";
import Icon from "../components/Icon.astro";
import Pie from "../components/Pie.astro";
import { sitio, wa, ciudades, rutaCiudad } from "../lib/sitio.js";
import d from "../datos/contacto.json";
---
<Layout titulo={d.meta.titulo} descripcion={d.meta.descripcion} activa="contacto">
  <section class="pagina-hero">
    <div class="container">
      <h1>{d.hero.titulo}</h1>
      <p class="lead">{d.hero.texto}</p>
      <p class="canales-titulo">{d.canalesTitulo}</p>
      <div class="hero-actions">
        <a class="btn btn-wa btn-lg" href={wa(sitio.mensajes.general)} target="_blank" rel="noopener">WhatsApp {sitio.telefono}</a>
        <a class="btn btn-ghost btn-lg" href={`tel:+${sitio.whatsapp}`}>Llamar {sitio.telefono}</a>
      </div>
    </div>
  </section>
  <Formulario titulo={d.formulario.titulo} texto={d.formulario.texto} />
  <section class="section faq">
    <div class="container faq-grid">
      <div class="faq-intro"><h2>{d.faq.titulo}</h2></div>
      <div class="faq-lista">{d.faq.items.map((f) => (<details><summary>{f.pregunta}<span class="mas" aria-hidden="true"></span></summary><p>{f.respuesta}</p></details>))}</div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{d.cobertura.titulo}</h2><p>{d.cobertura.texto}</p></div>
      <ul class="chips chips-lg">{ciudades.map((c) => <li><a href={rutaCiudad(c)}>{c.nombre}</a></li>)}</ul>
    </div>
  </section>
  <Pie />
</Layout>
